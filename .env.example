# Required only for the LLM copilot and optional dense embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# false = local TF-IDF retrieval; true = OpenAI dense embeddings.
USE_OPENAI_EMBEDDINGS=false

# Mock enterprise asset-management integration.
EAM_API_URL=http://127.0.0.1:8001
EAM_API_KEY=demo-secret-key

# Set to true on BOTH hosted services. Never use the example EAM key when enabled.
# Hosted mode blocks API writes/reset and hides mutation buttons in Streamlit.
HOSTED_DEMO_MODE=false

# Optional: enable AI only for reviewers with this access code.
# Set AI_DEMO_PASSWORD and OPENAI_API_KEY as PRIVATE Streamlit secrets.
# Do not configure either on the public Render API.
AI_DEMO_PASSWORD=
